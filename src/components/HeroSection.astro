---
import OrbitalArtwork from './OrbitalArtwork.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot"></span> Desktop software <span class="eyebrow-divider">/</span> Windows + Linux</p>
    <h1 id="hero-title">A little more<br />room to <em>think.</em></h1>
    <p class="hero-description">We make considered desktop software for the moments when your tools should simply make sense.</p>
    <div class="hero-actions">
      <a class="button button-light" href="#collection">Explore the collection <span aria-hidden="true">↘</span></a>
      <span class="platform-note">Made for Windows <span aria-hidden="true">·</span> Linux</span>
    </div>
    <div class="hero-footnote"><span>01</span><span class="footnote-rule"></span><span>Useful things, made with care.</span></div>
  </div>
  <OrbitalArtwork />
  <a class="scroll-cue" href="#approach"><span class="scroll-line"></span>Scroll to explore</a>
</section>
